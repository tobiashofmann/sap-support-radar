{
  "name": "pam-mcp-server",
  "version": "1.0.0",
  "description": "MCP server exposing the SAP product support data from webapp/model/PAM.json as queryable tools.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "pam-mcp-server": "dist/index.js"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "clean": "rm -rf dist",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "license": "Apache-2.0",
  "private": true
}
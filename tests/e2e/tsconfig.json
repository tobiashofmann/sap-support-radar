{
    "compilerOptions": {
        "target": "es2022",
        "module": "es2022",
        "moduleResolution": "node",
        "lib": ["es2022", "dom"],
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "noEmit": true,
        "types": ["node", "@playwright/test"]
    },
    "include": ["./**/*.ts", "../../playwright.config.ts"]
}
